SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 任意。添付を保存する download_file ツールを使うなら、保存先の絶対パスを書く（files:read スコープが要る）
# DOWNLOAD_DIR=
# 任意。on にすると実行許可に「このセッション中は全部許可」ボタンを出す（settings の ask / deny 以外を自動で許可する）
# SESSION_ALLOW_ALL=on
# 任意。キャッシュ（1 時間で切れる）のつなぎ止め。既定 on。最後の応答から KEEPALIVE_AFTER_MIN 分で短い合図を送る
# KEEPALIVE=on
# KEEPALIVE_AFTER_MIN=55
# 最後の会話から送る回数の上限（書き直し 1 回は合図約 20 回ぶん）
# KEEPALIVE_MAX=6
# 送らない時間帯（HH:MM-HH:MM。空なら時間帯なし）
# KEEPALIVE_QUIET=01:00-07:00
