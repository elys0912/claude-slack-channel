SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# 任意。添付を保存する download_file ツールを使うなら、保存先の絶対パスを書く（files:read スコープが要る）
# DOWNLOAD_DIR=
# 任意。on にすると実行許可に「このセッション中は全部許可」ボタンを出す（settings の ask / deny 以外を自動で許可する）
# SESSION_ALLOW_ALL=on
# 任意。キャッシュ（1 時間で切れる）のつなぎ止め。既定 on。最後の応答から KEEPALIVE_AFTER_MIN 分で短い合図を送る
# KEEPALIVE=on
# KEEPALIVE_AFTER_MIN=55
# 最後の会話から送る回数の上限（書き直し 1 回は合図約 20 回ぶん）
# KEEPALIVE_MAX=6
# 送らない時間帯（HH:MM-HH:MM。空なら時間帯なし）
# KEEPALIVE_QUIET=01:00-07:00
# 任意。使用量（5 時間枠・7 日枠）とコンテキストの見張り。既定 on。statusline の記録（usage.json）を読んで知らせる
# USAGE_WATCH=on
# 使用量のしきい値（%、カンマ区切り。空なら知らせない）
# USAGE_WARN_PCT=80,95
# コンテキストのしきい値（%、カンマ区切り。空なら知らせない）
# CONTEXT_WARN_PCT=70,90
# 任意。Claude Code が想定外に終了（exit code が 0 以外）したら、同じ会話で起動し直す（10 分に 3 回まで）。既定 on。start.ps1 が読む
# AUTO_RESTART=on
