{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "disableClaudeAiConnectors": true,
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "mcp__slackbridge__reply",
      "mcp__slackbridge__react",
      "mcp__slackbridge__edit_message",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Read(~/.claude/channels/**)",
      "Edit(~/.claude/channels/**)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)"
    ]
  }
}
